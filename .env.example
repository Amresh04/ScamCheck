# Optional. Without this key, Cyber Suraksha Saathi uses local rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Keep false in development and production unless HTTPS is configured.
COOKIE_SECURE=false
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Install these Tesseract language packs to read English and Hindi screenshots.
OCR_LANGUAGES=eng,hin
